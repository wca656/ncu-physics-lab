# ---------- 操作系统自动生成的垃圾文件 ----------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
*.lnk

# ---------- 编辑器 / IDE ----------
.vscode/*
!.vscode/settings.json.example
.idea/
*.swp
*.swo
*~
.vs/

# ---------- Python ----------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
develop-eggs/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
.venv/
venv/
env/
ENV/
.python-version

# ---------- Jupyter Notebook ----------
.ipynb_checkpoints/
*/.ipynb_checkpoints/*
profile_default/
ipython_config.py

# ---------- 科学计算 / 数据分析缓存 ----------
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
.dmypy.json

# ---------- LaTeX 编译中间产物（实验报告排版常用） ----------
*.aux
*.bbl
*.blg
*.dvi
*.fdb_latexmk
*.fls
*.fmt
*.fot
*.lof
*.log
*.lot
*.out
*.pdfsync
*.synctex.gz
*.toc
*.xdv

# ---------- MATLAB / Octave ----------
*.asv
*.m~
octave-workspace
*.mat

# ---------- 大型原始数据 / 二进制文件（建议只提交处理后的结果） ----------
*.bin
*.dat
*.raw
*.h5
*.hdf5
*.npy
*.npz

# ---------- 临时文件 ----------
*.tmp
*.temp
*.bak
*~
